<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- A fixed 108dp canvas prevents Android 12 from expanding and cropping the raw JPG. -->
    <item
        android:width="108dp"
        android:height="108dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item
        android:width="60dp"
        android:height="60dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/sure_trust_official_logo"
            android:gravity="fill" />
    </item>
</layer-list>
